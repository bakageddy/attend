<fieldset class="search__subject__group search__group" name="subject_fieldset">
  <legend class="search__group__legend" for="subject_fieldset">Search Subject(s)</legend>
  <Input
    id="search__subject__id"
    class="form__member search__input"
    type="number"
    placeholder="Search SubjectID"
    @value={{this.subjectid}}
    {{on 'input' this.search_subject_id }}
  />
  <Input
    id="search__subject__code"
    class="form__member search__input"
    type="text"
    placeholder="Search SubjectCode"
    @value={{this.subjectcode}}
    {{on 'input' this.search_subject_code }}
  />
  <Input
    id="search__subject__name"
    class="form__member search__input"
    type="text"
    placeholder="Search Subject"
    @value={{this.subjectname}}
    {{on 'input' this.search_subject_name }}
  />
  {{yield}}
</fieldset>