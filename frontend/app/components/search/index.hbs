<section class="container search">
  <form class="search__form">
    {{#if this.is_batch}}
      <Search::Batch/>
    {{else if this.is_teacher}}
      <Search::Teacher/>
    {{else if this.is_subject}}
      <Search::Subject/>
    {{else if this.is_student}}
      <Search::Student/>
    {{/if}}
  </form>
  <div class="search__tab__header">
    {{#each @fields as |field|}}
      <div class="search__tab__heading" {{on 'click' (fn this.set_field field)}}>
        {{field}}
      </div>
    {{/each}}
  </div>
  {{yield}}
</section>