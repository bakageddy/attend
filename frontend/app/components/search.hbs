<section class="container search">
  <form class="search__form">
      <fieldset class="search__student__group search__group" name="student_fieldset">
        <legend class="search__group__legend" for="student_fieldset">Search Student(s)</legend>
        <input id="search__student__id" class="form__member search__input" {{on 'input' this.search_student_id}} type="number" placeholder="Search RollNo"/>
        <input id="search__student__name" class="form__member search__input" type="text" {{on 'input' this.search_student_name}} placeholder="Search Student" />
      </fieldset>

      <fieldset class="search__teacher__group search__group" name="teacher_fieldset">
        <legend class="search__group__legend" for="teacher_fieldset">Search Teacher(s)</legend>
        <input id="search__teacher__id" class="form__member search__input" type="number" {{on 'input' this.search_teacher_id }} placeholder="Search TeacherID"/>
        <input id="search__teacher__name" class="form__member search__input" type="text" {{on 'input' this.search_teacher_name }} placeholder="Search Teacher" />
      </fieldset>

      <fieldset class="search__subject__group search__group" name="subject_fieldset">
        <legend class="search__group__legend" for="subject_fieldset">Search Subject(s)</legend>
        <input id="search__subject__id" class="form__member search__input" type="number" {{on 'input' this.search_subject_id }} placeholder="Search SubjectID"/>
        <input id="search__subject__code" class="form__member search__input" type="text" {{on 'input' this.search_subject_code }} placeholder="Search SubjectCode" />
        <input id="search__subject__name" class="form__member search__input" type="text" {{on 'input' this.search_subject_name }} placeholder="Search Subject" />
      </fieldset>

      <fieldset class="search__batch__group search__group" name="batch_fieldset">
        <legend class="search__group__legend" for="batch_fieldset">Search Batch(s)</legend>
        <input id="search__batch__id" class="form__member search__input" type="number" {{on 'input' this.search_batch_id }} placeholder="Search BatchID"/>
        <input id="search__batch__teacherid" class="form__member search__input" type="number" {{on 'input' this.search_batch_teacherid }} placeholder="Search BatchOwner/TeacherID" />
        <input id="search__batch__name" class="form__member search__input" type="text" {{on 'input' this.search_batch_name }} placeholder="Search Batch" />
      </fieldset>
  </form>
  {{yield}}
</section>