<section class="container attendance">
  <form class="attendance__form">
    <Input
      name="teacherid"
      id="attendance__form__teacherid"
      class="form__member"
      type="number"
      placeholder="TeacherID"
      @value={{this.teacherid}}
    />
    <Input
      name="subjectid"
      id="attendance__form__subjectid"
      class="form__member"
      type="number"
      placeholder="SubjectID"
      @value={{this.subjectid}}
    />
    <Input
      name="rollno"
      id="attendance__form__rollno"
      class="form__member"
      type="number"
      placeholder="Student Rollno"
      @value={{this.studentid}}
    />
    <Input
      name="date"
      id="attendance__form__date"
      class="form__member"
      type="date"
      placeholder="Date"
      @value={{this.date}}
    />
    <select
      name="period"
      id="attendance__form__period"
      class="form__member"
    >
      <option>I</option>
      <option>II</option>
      <option>III</option>
      <option>IV</option>
      <option>V</option>
      <option>VI</option>
      <option>VII</option>
      <option>VIII</option>
    </select>
    <div class="attendance__submit__group">
      <button
        {{on 'click' this.insert_attendance}}
        class="form__member btn attendance__submit__btn"
        type="submit">
        Set Attendance
      </button>

      <button
        {{on 'click' this.delete_attendance}}
        class="form__member btn attendance__submit__btn"
        type="submit">
        Delete Attendance
      </button>
    </div>
  </form>

  <form action="http://localhost:8080/app/api/attendance/batch" method="POST" class="batch__attendance__form">
    <Input
      name="batchid"
      id="batch__attendance__form__batchid"
      class="form__member"
      type="number"
      placeholder="BatchID"
      @value={{this.batchid}}
    />
    <Input
      name="teacherid"
      id="batch__attendance__form__teacherid"
      class="form__member"
      type="number"
      placeholder="TeacherID"
      @value={{this.teacherid}}
    />
    <Input
      name="subjectid"
      id="batch__attendance__form__subjectid"
      class="form__member"
      type="number"
      placeholder="SubjectID"
      @value={{this.subjectid}}
    />
    <Input
      name="date"
      id="batch__attendance__form__date"
      class="form__member"
      type="date"
      placeholder="Date"
      @value={{this.date}}
    />
    <select name="period" id="batch__attendance__form__period" class="form__member">
      <option>I</option>
      <option>II</option>
      <option>III</option>
      <option>IV</option>
      <option>V</option>
      <option>VI</option>
      <option>VII</option>
      <option>VIII</option>
    </select>
    <button class="form__member btn attendance__submit__btn" type="submit">Set Attendance</button>
  </form>
  {{yield}}
</section>